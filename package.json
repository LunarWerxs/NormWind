{
  "name": "@lunawerx/normwind",
  "version": "3.8.0",
  "description": "Normalize Tailwinds: Tailwind shorthand audit, canonicalization checks, and safe autofix",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LunarWerxs/NormWind.git"
  },
  "homepage": "https://github.com/LunarWerxs/NormWind",
  "bugs": {
    "url": "https://github.com/LunarWerxs/NormWind/issues"
  },
  "bin": {
    "normwind": "bin/normwind.mjs",
    "normwinds": "bin/normwind.mjs"
  },
  "files": [
    "bin/normwind.mjs",
    "lib/*.mjs",
    "docs/reference/canonical-replacements.json",
    "docs/reference/canonical-replacements.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:action": "node scripts/build-action.mjs",
    "build:action:check": "node scripts/build-action.mjs --check",
    "canonical:extract": "node bin/normwind.mjs --extract-canonical --write-canonical-files",
    "canonical:check": "node bin/normwind.mjs --check-canonical",
    "deps:sync": "bun install && npm ci && npm run build:action",
    "test": "node scripts/test-units.mjs && node scripts/test-prepush.mjs && node scripts/test-action.mjs",
    "prepush": "npm test",
    "test:action": "node scripts/test-action.mjs",
    "test:regression": "node scripts/test-regression.mjs",
    "test:regression:update": "node scripts/test-regression.mjs --update",
    "test:compare": "node scripts/test-compare.mjs",
    "test:units": "node scripts/test-units.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "tailwind",
    "tailwindcss",
    "eslint",
    "lint",
    "cli",
    "shorthand",
    "canonicalization",
    "autofix",
    "codemod",
    "vue",
    "react",
    "typescript",
    "utility-classes",
    "class-normalization"
  ],
  "dependencies": {
    "@babel/parser": "7.29.8",
    "eslint-plugin-tailwindcss": "3.18.3",
    "tailwindcss": "4.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@actions/core": "3.0.1",
    "@vercel/ncc": "0.45.0"
  }
}
