# npm pack artefacts — never commit tarballs
*.tgz

# local env / secrets
.env
.env.*
*.npmrc

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# dependencies
node_modules/

# scratch / tooling sandboxes
.tmp/
.venv/
.saydeploy/

# regression-harness scratch output (only emitted when a fixture diverges)
test/fixtures/**/actual.*

# editor / refactor backups
*.bak

# Generated agent code map (local artifact; rebuild with ~/.claude/tools/codemap.py)
.claude/codemap/

# ⛔ PUBLIC REPO: the to-do list is not published (owner directive, 2026-08-29).
# These notes are the most candid writing in the repo - what is broken, what is half-built, what is
# waiting on a person - and Odin's Loki files them here automatically from chat history. The
# folder's own README stays tracked (it is already tracked, and it states the convention); only the
# items are ignored. Managed by public_todo_guard.py in the Odin repo.
/docs/todo/*
!/docs/todo/README.md

# ⛔ PUBLIC REPO: the agent memory folder is not published (2026-09-01).
# Same reasoning as the to-do list above, and it was missed when that rule was written:
# .claude/codemap/ and .claude/settings.local.json were both excluded, .claude/memory/ was
# not - and MEMORY.md was already sitting in it untracked, one `git add -A` from being
# public. These files are candid internal notes about what is broken and what is waiting on
# whom; publishing them is irreversible (forks, code search, scrapers). The ignore line goes
# in BEFORE the files land, never after - this one is already late.
/.claude/memory/
